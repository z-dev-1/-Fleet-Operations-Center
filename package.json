{
  "name": "fleet-ops-app",
  "version": "3.1.0-beta.11",
  "description": "Fleet Operations Platform — Version C",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development concurrently \"vite\" \"electron .\"",
    "build:renderer": "vite build",
    "build:app": "npm run build:renderer && electron-builder --win --x64",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ renderer/src/ --ext .js,.ts",
    "launch": "start /min cmd /c npm run dev",
    "launch:hidden": "powershell -WindowStyle Hidden -Command \"npm run dev\"",
    "test:watch": "vitest",
    "test:smoke:electron": "electron tests/smoke/justme-libs-main.cjs && npm run test:smoke:workers",
    "test:smoke:workers": "electron tests/smoke/worker-host-main.cjs",
    "test:bench:workers": "node tests/workers-isolation-fixtures/run-bench.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.5.4",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1073.0",
    "@aws-sdk/credential-providers": "^3.1073.0",
    "@kenjiuno/msgreader": "1.29.0",
    "heic-convert": "2.1.0",
    "jszip": "^3.10.1",
    "juice": "^12.1.1",
    "mailparser": "3.14.1",
    "mammoth": "1.13.0",
    "nodemailer": "^9.0.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.61.1",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@napi-rs/canvas": "1.1.0"
  },
  "build": {
    "appId": "com.amazon.fleet-ops",
    "productName": "Fleet Operations",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "files": [
      "renderer/src/**/*",
      "dist/renderer/**/*",
      "src/**/*",
      "setup/**/*",
      "assets/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "!dist/win-unpacked/**",
      "!**/*.bak*",
      "!src/asana/_test_ops.js",
      "!src/scrapers/aap_custom_form_probe.js"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ]
  }
}
