    {
      "fieldType": "selectInput",
      "propertyName": "primaryCauseCode",
      "displayName": "Primary Cause Code",
      "selectOptions": [
        "Technician Error",
        "Asset Design Defect",
        "Component Manufacturing Defect",
        "Preventative Maintenance Quality",
        "Preventative Maintenance Gap",
        "Electrical/Power Failure",
        "Operational Process Failure",
        "Operator Failure",
        "Collision/Impact",
        "Driver/Operator Abuse"
      ],
      "allowsMultiple": true,
      "helperText": "Technician Error - Improper or Failed Previous Repair\nAsset Design Defect - Poor design caused failure\nComponent Manufacturing Defect - Part was incorrectly manufactured\nPreventative Maintenance Quality - PM was not performed as prescribed or with low quality\nPreventative Maintenance Gap - PM routine is insufficient\nElectrical/Power Failure - NOT Communication or Code Failure\nOperational Process Failure - Driven By Process Mistake\nOperator Failure - Driven By Operator/Driver Mistake\nCollision/Impact - Asset struck another object or vice versa\nDriver/Operator Abuse - Driver caused damaged (non-collison)"
    },
